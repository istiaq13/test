*.dll

# Libraries (ignore build outputs, keep prebuilt vendor dependencies)
*.lib
!**/Dependencies/**/*.lib

# ==========================================
# Backup, Temp, and Editor Files
# ==========================================
*.bak
*.tmp
*.temp
*~
*.swp
*.swo

# VS Code / JetBrains IDEs
.vscode/
.idea/

